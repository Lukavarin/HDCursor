{
  "manifest_version": 3,
  "name": "Phantom Cursor & Navigation Controller",
  "short_name": "HDCursor",
  "version": "1.0.0",
  "description": "Neutralizes mouse cursor interactions globally with customizable hotkeys for tab navigation and cursor visibility.",
  "browser_specific_settings": {
    "gecko": {
      "id": "hdcursor@private.addon",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "storage",
    "tabs",
    "sessions"
  ],
  "background": {
    "scripts": [
      "shared/defaults.js",
      "shared/storage.js",
      "background/background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "shared/defaults.js",
        "shared/storage.js",
        "content/content.js"
      ],
      "css": [
        "content/shield.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "HDCursor",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
